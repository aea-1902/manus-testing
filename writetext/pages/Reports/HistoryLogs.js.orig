const StyledTableCell = styled(TableCell)(({ theme }) => ({
    [`&.${tableCellClasses.head}`]: {
      backgroundColor: theme.palette.common.black,
      color: theme.palette.common.white
    },
    [`&.${tableCellClasses.body}`]: {
      fontSize: 14,
    },
  }));

  function formatDate(date) {
    const d = new Date(date)
    const userLocale = navigator.language.substring(0,2);
    const options = {
      year: 'numeric',
      month: userLocale == 'en' ? 'short' : 'long' ,
      day: 'numeric',
    };
    const formattedDate = d.toLocaleDateString(userLocale, options);
    return formattedDate
  
  }

  function formatTime(date) {
    const momentDate = moment.utc(date);
    const localDate = momentDate.local();

    const formattedDate = localDate.format('YYYY-MM-DD HH:mm:ss');
    return formattedDate.split(' ')
  
  }

function Row(props) {
    const { row } = props;
    const [open, setOpen] = React.useState(false);
  
    return (
      <React.Fragment>
        <TableRow className='row-pointer' onClick={() => setOpen(!open)}>
          <TableCell className='fields-generated'>
            <div className="d-flex">
                <div>

                    <p className="font-16 history-datetime d-flex"><p>{formatDate(row.timeStamp)}</p> <p className='history-editor mlr-10'>|</p><p>{formatTime(row.timeStamp)[1]} {formatTime(row.timeStamp)[2]}</p></p>
                    {row.objectType == "Generate" 
                    
                    ?
                    
                    <p className='font-13 history-editor'>{row.actionDisplay} | {row.creditUsed} credits used</p>
                     :
                     
                    <p className='font-13 history-editor'>{row.actionDisplay}</p>
                     }

                    {/* <p className='font-13 history-editor'>{row.objectType == "Generate" ? 'Generated by' : row.objectType == "Update" ? 'Saved by' : `Transferred to ${row.objectType.split(",").pop()} by`} {row.editors.toString()}</p> */}
                </div>
                <div className="ml-auto">
                    <IconButton aria-label="expand row" size="small">
                        {open ? <KeyboardArrowUpIcon /> : <KeyboardArrowDownIcon />}
                    </IconButton>
                </div>
            </div>
          </TableCell>
        </TableRow>
        <TableRow>
          <TableCell style={{ padding: 0}} colSpan={12}>
            <Collapse in={open} timeout="auto" unmountOnExit>
                 <Table sx={{ minWidth: 700, border:'none' }} >
                  <TableBody>
                      <StyledTableCell sx={{borderBottom: 'none'}} >
                        
                          {row.fields.map((r,i) => (
                              <div key={i}>
                                <div>
                                  <p className='font-14 field history'>{r.fieldType}</p>
                                </div>
                                  {
                                    r.value.map((v,ix) => (
                                   
                                           <div key={ix} >
                                          < p className='font-13 history'  >• {v.replace(/\n/g, '<br>')}</p>
                                          </div>
                                      
                                    ))
                                  }
                                  
                                  <hr className="solid"></hr>
                              </div>
                              
                          ))}
                      </StyledTableCell>
                  </TableBody>
                </Table>
            </Collapse>
          </TableCell>
        </TableRow>
      </React.Fragment>
    );
  }


export default function HistoryLogs({userData}) {
  const router = useRouter();

  
const [data, setData] = useState(null)

const https = require("https");
const httpsAgent = new https.Agent({ rejectUnauthorized: false });
const AppSettings = require('../../settings/AppSetting').default
const [storeId, setStoreid] = useState('');
const [page, setPage] = useState(0);
const [recordsPerPage, setRecordsPerPage] = useState(100);
const [pageSize, setPageSize] = useState(100);
const [loading, setLoading] = useState(true);
const [hasMore, setHasMore] = useState(true);
const [continuationToken, setContinuationToken] = useState(null);
const [credits, setCredits] = useState(null);
const [translation, setTranslation] = useState(null);

const [queryParanms, setQueryParams] = useState({});

const [generatingCsv, setGeneratingCsv] = useState(false);
const [selectedUrl, setSelectedUrl] = useState('');
async function getReports(){

  const emailRegex = /\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b/g;

    const {
      query: {urlId, storeId, textId,startDate, endDate, user, url}
    } = router
     let props = {
      urlId, storeId, textId, startDate, endDate, user, url
     }
    
     if (props,url != undefined)
        setSelectedUrl(props.url)
     if (props.urlId != undefined)
     {
      setQueryParams(props)
     }else
     {
      props = queryParanms;
     }
     setStoreid(props.storeId)
  

    const formData = new FormData()

    formData.append('type', 'Product')
    if (props.urlId != "" && props.urlId != undefined)
      formData.append('urlId', props.urlId)

    if (props.storeId != "" && props.storeId != undefined)
      formData.append('storeId', props.storeId)

    if (props.textId != "" && props.textId != undefined)
      formData.append('textId', props.textId)

    if (continuationToken != null)
      formData.append('continuationToken', continuationToken)

    if (props.startDate != "" && props.startDate != undefined)
      formData.append('startDate', props.startDate)

    if (props.endDate != "" && props.endDate != undefined)
      formData.append('endDate', props.endDate)

    if (props.user != "All" && props.user != undefined)
    {
      const userMatch = window.location.search.match(emailRegex);
      formData.append('userName', encodeURI(userMatch))
    }
    if ((props.storeId != undefined && props.urlId != undefined) || props.textId != undefined)
    {
      
    await ApiService.postWithFormData(`/Reporting/History`, formData)
    .then(res => {
           if (res.data.histories.length > 0){
        
        setContinuationToken(res.data.continuationToken)
        if (res.data.continuationToken == null)
        {
          setHasMore(false)
        }
        else
        {
          setHasMore(true)
        }
        if (data != null)
        {
          setData([...data, ...res.data.histories])
        }else{
          setData(res.data.histories)
        }
      }
      else
      {
        setHasMore(false)
      }
    })
    .catch(error => {
           setLoading(false);
          setHasMore(false)
    });
    }

   
}

const exportToCsv = async (json) => {
  try {
    // Parse JSON from request body
    const jsonArray = json;

    // Check if the input is valid
    if (!Array.isArray(jsonArray)) {
      return res.status(400).json({ error: 'Invalid JSON format. Expected an array of objects.' });
    }

    // Flatten each object in the array
const rows = jsonArray.flatMap(data => {
  return data.fields.flatMap(field => {
    return field.value.map(value => ({
      'URL': selectedUrl,
      'Store ID': data.storeId,
      'Request ID': data.requestId,
      'Text ID': field.documentId,
      'Editor': data.editor,
      'Action': data.actionDisplay + ' ' + data.objectType,
      'Text Type': field.fieldType,
      'Text': value,
      'Time': data.timeStamp + 'Z' // Format timestamp
    }));
  });
});
    const startDateObj = new Date(Number(queryParanms.startDate)).toLocaleDateString()
    const endDateObj = new Date(Number(queryParanms.endDate)).toLocaleDateString()


    const today = new Date().getTime()
    const fileName = `HistoryLogs_${startDateObj}-${endDateObj}_${today}.csv`;
    


// Convert rows with custom headers using Papa.unparse
const csv = Papa.unparse({
  fields: ['URL','Store ID', 'Request ID', 'Text ID', 'Editor', 'Action', 'Text Type', 'Text', 'Time'],
  data: rows
});

    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.setAttribute('download', fileName);
    document.body.appendChild(link);
    link.click();
    link.remove();
    window.URL.revokeObjectURL(url);
    
    setGeneratingCsv(false);
  } catch (error) {
  }
}
const exportHistory = async () => {
  
  let exportContinuationToken = ''
  let exportHasMore = true
  let exportData = []

  const postAndCheckHasMore = async () => {
    
  const formData = new FormData()
  formData.append('type', 'Product')
  if (queryParanms.urlId != "" && queryParanms.urlId != undefined)
    formData.append('urlId', queryParanms.urlId)
  if (queryParanms.storeId != "" && queryParanms.storeId != undefined)
    formData.append('storeId', queryParanms.storeId)
  if (queryParanms.textId != "" && queryParanms.textId != undefined)
    formData.append('textId', queryParanms.textId)
  if (continuationToken != null)
    formData.append('continuationToken', exportContinuationToken)
  if (queryParanms.startDate != "" && queryParanms.startDate != undefined)
    formData.append('startDate', queryParanms.startDate)
  if (queryParanms.endDate != "" && queryParanms.endDate != undefined)
    formData.append('endDate', queryParanms.endDate)
  
    if ((queryParanms.storeId != undefined && queryParanms.urlId != undefined) || queryParanms.textId != undefined) {
      setGeneratingCsv(true);
      await ApiService.postWithFormData(`/Reporting/History`, formData)
        .then(res => {
          if (res.data.histories.length > 0) {
            exportContinuationToken = res.data.continuationToken
            if (res.data.continuationToken == null) {
              
              exportHasMore = false
              
              exportData = [...exportData, ...res.data.histories]
              exportToCsv(exportData)
            }
            else
            {
              if (exportData.length > 0) {
                exportData = [...exportData, ...res.data.histories] 
              } else {
                exportData = [...res.data.histories]
              }
  
              if (exportHasMore) {
                // Update continuationToken and repeat the post
                exportContinuationToken = res.data.continuationToken
                postAndCheckHasMore()
              }
            }

          } else {
            exportHasMore = false
          }
        })
        .catch(error => {
          exportHasMore = false
        })
    }
  }

  postAndCheckHasMore()
 
}
  useEffect(() => {
    async function Init(){
      
      const locale = navigator.language.substring(0,2);
      setTranslation(t[locale] != undefined ? t[locale].Content["HistoryLogs"] : t["en"].Content["HistoryLogs"])
