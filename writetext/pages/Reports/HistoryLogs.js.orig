    {
      const element = document.getElementById('main-container');
      function handleScroll() {
        const scrollableHeight = element.scrollHeight - element.clientHeight;
        if (element.scrollTop === scrollableHeight) {
          setPage(page + 1);
          if (hasMore)
            getReports();
        }
      }
      element.addEventListener('scroll', handleScroll);
      return () => element.removeEventListener("scroll", handleScroll);
    }
    
  },[data])
 
  if (translation && userData)
  return (
    <>
    <ModalDialog target="billing" type="billing" click={() => {router.push('/billing')}}/>
      <Body>
        <Content backgroundclass={"scrollable-container"}>
     <div className="header d-flex h-39 mb-14">
        <div><p>{translation["PageHeaderText"]}</p></div>
        <div className='ml-auto font-14'><Link href="/reports"><Image className='mr-8' src="/images/ic-back.svg" width="8" height="10" alt='back'></Image>Back to reporting</Link></div>
    </div>
    <div className='mb-36 d-flex '>
      { data != null &&
           <Link passHref={true} href={`https://`+ storeId} className='font-16 mb-14 sub-p link'>{storeId}</Link>
          
      }
      <div className="right ms-auto">
